{
  "$id": "urn:adp:v2.4:candidate-v7:promotion-attestation-schema:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attestation_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "authorization_scope": {
      "const": "CREATE_C2_ONLY"
    },
    "candidate": {
      "const": "v7"
    },
    "candidate_package": {
      "additionalProperties": false,
      "properties": {
        "applied_state_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "governing_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "applied_state_sha256",
        "contract_sha256",
        "governing_manifest_sha256"
      ],
      "type": "object"
    },
    "created_utc": {
      "format": "date-time",
      "type": "string"
    },
    "governing_records": {
      "additionalProperties": false,
      "properties": {
        "independent_full_diff_review_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "procedure_freeze_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "quality_gate_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "write_set_v5_sha256": {
          "const": "0fb254adbed71aefe7197bbf29962bb3e0b44062cfdce62a1f83355e0f9476fb"
        }
      },
      "required": [
        "write_set_v5_sha256",
        "quality_gate_record_sha256",
        "independent_full_diff_review_sha256",
        "procedure_freeze_record_sha256"
      ],
      "type": "object"
    },
    "promotion_decision": {
      "const": "PASS"
    },
    "release": {
      "const": "ADP-v2.4"
    },
    "repository": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "const": "adp-v2.4-candidate-v7-controlled-remediation"
        },
        "c1_commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "c1_parent_sha": {
          "const": "b934c7bd84bfbc35563f3681712c4d5bd8478196"
        },
        "c1_tree_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "origin": {
          "const": "git@github.com:TimSimmons3/AI-Development-Platform.git"
        },
        "root_identifier": {
          "const": "AI-Development-Platform"
        }
      },
      "required": [
        "origin",
        "root_identifier",
        "branch",
        "c1_commit_sha",
        "c1_tree_sha",
        "c1_parent_sha"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0"
    },
    "signer": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ssh-ed25519"
        },
        "fingerprint": {
          "const": "SHA256:0qeoMO4IKy6h+1f1FX3YjBWO74wojsLoFETWp4YEy1c"
        },
        "namespace": {
          "const": "adp-v2.4-candidate-v7-promotion"
        },
        "principal": {
          "const": "timothy_simmons99@yahoo.com"
        }
      },
      "required": [
        "principal",
        "fingerprint",
        "algorithm",
        "namespace"
      ],
      "type": "object"
    },
    "write_set": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "blob_sha1": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "git_mode": {
            "enum": [
              "100644",
              "100755"
            ]
          },
          "path": {
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "git_mode",
          "blob_sha1",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 68,
      "minItems": 68,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "release",
    "candidate",
    "attestation_id",
    "created_utc",
    "repository",
    "candidate_package",
    "governing_records",
    "write_set",
    "signer",
    "promotion_decision",
    "authorization_scope"
  ],
  "title": "ADP v2.4 Candidate v7 Promotion Attestation",
  "type": "object",
  "x_canonical_serialization": "UTF-8, LF, sorted object keys, separators comma and colon, no insignificant whitespace before detached signing",
  "x_cross_field_controls": [
    "write_set paths must be unique",
    "all 68 entries must match C1 exactly",
    "all authorization states in C1 must remain held"
  ]
}
