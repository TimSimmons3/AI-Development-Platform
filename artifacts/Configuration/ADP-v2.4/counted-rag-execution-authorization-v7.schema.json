  "title": "ADP v2.4 Candidate v7 Execution Authorization - Canonical Trust Bindings v12",
  "type": "object",
  "x_cross_field_controls": [
    "expires_utc must be later than authorized_utc when present",
    "authorization_id must not appear in prior consumption evidence",
    "signer final operational adjudication must be PASS and signed",
    "workspace must be new and empty before evidence creation",
    "c2 commit and tree must match HEAD exactly",
    "execution must acquire an exclusive lock before checking or reserving authorization_id",
    "authorization_id must be absent from the durable registry before reservation",
    "reservation must be appended and fsynced before runtime execution begins",
    "a reserved or consumed authorization_id must be rejected in every workspace",
    "after execution the same registry entry must be finalized as CONSUMED or FAILED",
    "the control-root directory must be owned by authorized_uid and authorized_gid with mode 0700",
    "every control-root path component must be opened or validated without following symlinks",
    "the lock file must be opened with O_NOFOLLOW and must remain the same device and inode for the process lifetime",
    "the lock file must never be unlinked, renamed, truncated, or replaced",
    "the registry file must be a regular file owned by the authorized uid and gid with mode 0600 and link count 1",
    "parent directory fsync is required after creating the control root, lock file, or registry file",
    "every registry line must validate against the bound registry-entry schema",
    "every registry line must pass sequence, entry-hash, and prior-entry-hash validation before reservation",
    "the frozen semantic validator must pass before reservation append",
    "RESERVED reservation_event_id must equal event_id",
    "the current no-follow lock pathname must match the locked descriptor after acquisition",
    "the same pathname-to-descriptor identity check must pass before lock release",
    "terminal events must preserve immutable reservation context",
    "an authorization_id may have at most one terminal event",
    "the signed remote registry-head witness must match the local registry before execution and after every append",
    "the witness branch update must be a direct fast-forward child of the previously verified remote head",
    "authorization cannot advance until git ls-remote and fetched anchor verification confirm the exact pushed OID",
    "the anchor must validate against the frozen schema",
    "the complete registry must pass the frozen semantic validator",
    "registry_file_sha256 must equal the complete registry bytes",
    "the sequence-one anchor must be a direct child of the signed genesis parent",
    "current no-bypass ruleset evidence must pass before every witness verification",
    "remote verification must use an isolated temporary clone",
    "historical receipts verify against their named commit",
    "only the current head is compared to the live remote ref",
    "historical evidence freshness is measured against signed receipt creation time",
    "current branch-protection state requires separately collected fresh evidence",
    "pre-creation readiness evidence is schema and semantically validated against the first anchor time",
    "all security JSON parsing rejects duplicate keys",
    "current-state evidence digest and remote OID are bound into the signed authorization",
    "the verifier independently queries GitHub for both rulesets and the effective rule set",
    "the verifier performs a final remote-head recheck before PASS",
    "writer restrictions and no-bypass integrity rules are cumulative",
    "every witness commit must be GitHub-verified signed",
    "poisoned witness history triggers a signed epoch transition rather than a rewrite",
    "PRE_CREATION evidence has an absent branch and includes effective rules for the prospective ref",
    "POST_PUSH and CURRENT_STATE evidence require effective rules",
    "authenticated API subject equals the frozen writer actor",
    "both ruleset-history preflights succeed with Administration write permission",
    "GITHUB_TOKEN is neither persisted nor emitted",
    "legacy trust-hash aliases are rejected by additionalProperties false",
    "canonical trust hashes must match the Package v12 manifest exactly"
  ]
}
